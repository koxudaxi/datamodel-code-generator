{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NativeDataclassRenderer",
  "description": "A generated dataclass rendered without Jinja dispatch.",
  "deprecated": true,
  "type": "object",
  "required": [
    "identifier",
    "profile"
  ],
  "properties": {
    "identifier": {
      "type": "integer",
      "description": "Stable identifier."
    },
    "display-name": {
      "type": "string",
      "description": "Human readable display name."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "default": {}
    },
    "profile": {
      "$ref": "#/$defs/Profile"
    }
  },
  "$defs": {
    "Profile": {
      "type": "object",
      "required": [
        "email"
      ],
      "properties": {
        "email": {
          "type": "string"
        },
        "active": {
          "type": "boolean",
          "default": true
        }
      }
    }
  }
}
