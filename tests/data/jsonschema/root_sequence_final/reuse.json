{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Values",
  "type": "array",
  "items": {
    "anyOf": [
      {
        "$ref": "#/$defs/A"
      },
      {
        "$ref": "#/$defs/B"
      }
    ]
  },
  "$defs": {
    "A": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ItemA"
      }
    },
    "B": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ItemB"
      }
    },
    "ItemA": {
      "type": "object",
      "properties": {
        "value": {
          "type": "integer"
        }
      },
      "required": [
        "value"
      ]
    },
    "ItemB": {
      "type": "object",
      "properties": {
        "value": {
          "type": "integer"
        }
      },
      "required": [
        "value"
      ]
    }
  }
}
