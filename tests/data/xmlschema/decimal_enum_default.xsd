<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="Model">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="amount" minOccurs="0" default="12.30">
          <xs:simpleType>
            <xs:restriction base="xs:decimal">
              <xs:enumeration value="12.30"/>
              <xs:enumeration value="45.60"/>
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
